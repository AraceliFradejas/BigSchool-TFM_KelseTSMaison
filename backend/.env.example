PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
# Local SQLite. Keep this directory outside Git. Production needs persistent disk.
DATABASE_PATH=./runtime/maison.sqlite
UPLOAD_DIR=./runtime/uploads
NODE_ENV=development
# Set to 1 only behind one trusted reverse proxy that overwrites forwarding headers.
TRUST_PROXY=0
