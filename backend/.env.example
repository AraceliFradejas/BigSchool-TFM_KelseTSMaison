# KelseTS Maison — Vercel + MongoDB + Cloudinary
# Copy to backend/.env. This example must never contain real credentials.
# Local execution. In Vercel use NODE_ENV=production and the real web HTTPS origin.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
TRUST_PROXY=0

# MongoDB Atlas — dedicated Maison database and database user.
DATABASE_PROVIDER=mongodb
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=
MONGODB_DATABASE=kelsets_maison

# Cloudinary — own integration; never copy Cars credentials.
MEDIA_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kelsets-maison/team

# Optional offline mode: DATABASE_PROVIDER=sqlite and MEDIA_STORAGE=local.
DATABASE_PATH=./runtime/maison.sqlite
UPLOAD_DIR=./runtime/uploads

# Native app and AI outfit assistant are requested extensions, not implemented yet.
# Provider/model configuration will be added when the assistant integration is chosen.
# Never put database, Cloudinary or AI secrets in VITE_* or EXPO_PUBLIC_* variables.
