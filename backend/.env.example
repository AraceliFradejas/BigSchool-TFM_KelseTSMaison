# KelseTS Maison — Vercel + MongoDB + Cloudinary
# Copy to backend/.env. This example must never contain real credentials.
# Local execution. In Vercel use NODE_ENV=production and the real web HTTPS origin.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
TRUST_PROXY=0

# MongoDB Atlas — dedicated Maison database and database user.
DATABASE_PROVIDER=mongodb
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=
MONGODB_DATABASE=kelsets_maison

# Cloudinary — own integration; never copy Cars credentials.
MEDIA_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kelsets-maison/team

# Optional offline mode: DATABASE_PROVIDER=sqlite and MEDIA_STORAGE=local.
DATABASE_PATH=./runtime/maison.sqlite
UPLOAD_DIR=./runtime/uploads

# Explicit creation with npm run team:create. Never used by public registration.
ADMIN_EMAIL=team@kelsets.example
ADMIN_PASSWORD=

# Native app uses the public HTTPS API; it never receives the private values above.
# Never put database, Cloudinary or AI secrets in VITE_* or EXPO_PUBLIC_* variables.

# Maison Stylist: disabled until keys, models and usage limits are reviewed.
# Keys belong only to Maison and must never be placed in frontend/mobile variables.
STYLIST_ENABLED=0
STYLIST_REQUIRE_ACCOUNT=1
# Optional ISO expiration; never start a provider request at or after this instant.
STYLIST_EXPIRES_AT=
STYLIST_PROVIDERS=gemini,anthropic,openai
STYLIST_DAILY_CALL_LIMIT=20
STYLIST_TIMEOUT_MS=8000
STYLIST_MAX_OUTPUT_TOKENS=1200
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
