{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "assets/email/**",
      "excludeFiles": "{../frontend/public/**,../frontend/dist/**,runtime/**,test/**}"
    }
  },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index" }]
}
