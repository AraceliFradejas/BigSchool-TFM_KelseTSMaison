      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Maison-Request",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/logout",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
