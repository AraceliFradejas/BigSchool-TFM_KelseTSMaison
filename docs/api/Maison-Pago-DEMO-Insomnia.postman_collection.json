          "raw": "{\n  \"idempotencyKey\": \"cd414d7f-b003-4f54-bfa7-01966b8921f7\",\n  \"lines\": [\n    {\n      \"variantId\": \"satin-story-1\",\n      \"quantity\": 1\n    }\n  ],\n  \"expectedTotalCents\": 185000,\n  \"payment\": {\n    \"mode\": \"demo\",\n    \"method\": \"card\",\n    \"acknowledged\": true,\n    \"outcome\": \"approved\",\n    \"fulfillment\": {\n      \"method\": \"pickup\",\n      \"recipientName\": \"Cliente ficticio Maison\",\n      \"boutiqueId\": \"madrid-milla-oro\"\n    }\n  }\n}",
