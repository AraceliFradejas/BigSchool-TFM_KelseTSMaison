      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/team/orders/REEMPLAZAR_ID_PEDIDO",
        "header": [
          {
            "key": "X-Maison-Request",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "409 invalid_transition; sin correo.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"delivered\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "P16 · Confirmar pedido",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/team/orders/REEMPLAZAR_ID_PEDIDO",
