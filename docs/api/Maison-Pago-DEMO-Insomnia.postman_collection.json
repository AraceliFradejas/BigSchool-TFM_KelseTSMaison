        "url": "{{base_url}}/orders/REEMPLAZAR_ID_PEDIDO",
        "header": [
          {
            "key": "X-Maison-Request",
            "value": "1"
          }
        ],
        "description": "200. DEMO, pago simulado, cargo real0."
      }
    },
    {
      "name": "P12 · Correo único de compra",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/messages",
        "header": [
          {
            "key": "X-Maison-Request",
            "value": "1"
          }
        ],
        "description": "200. Una comunicación pending; Sandbox pending no significa enviado, SMTP está apagado."
      }
    },
    {
      "name": "P13 · Cerrar cliente",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/logout",
        "header": [
          {
            "key": "X-Maison-Request",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
