{
  "info": {
    "name": "KelseTS Maison · pago DEMO y estados",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Segunda ronda local aislada. SMTP e IA desactivados. Sustituir REEMPLAZAR_ID_PEDIDO en las URLs por data.id de la operación 09. Ejecución manual en orden con cookie jar."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:3179/api/v1"
    },
    {
      "key": "customer_email",
      "value": "preview@maison.example"
    },
    {
      "key": "team_email",
      "value": "team@maison.example"
    },
    {
      "key": "test_password",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "P01 · Acceder cliente",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/auth/login",
        "header": [
          {
            "key": "X-Maison-Request",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "200. Solo cuentas de la copia local.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{customer_email}}\",\n  \"password\": \"{{test_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "P02 · Stock inicial",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/products/satin-story",
        "header": [
          {
            "key": "X-Maison-Request",
            "value": "1"
          }
        ],
        "description": "200. satin-story-1: stock6."
      }
    },
    {
      "name": "P03 · Comunicaciones iniciales",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/messages",
        "header": [
          {
            "key": "X-Maison-Request",
            "value": "1"
          }
        ],
        "description": "200. Vacías en una base nueva."
      }
    },
    {
      "name": "P04 · Pago DEMO rechazado",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/checkout/demo",
        "header": [
          {
            "key": "X-Maison-Request",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "409 demo_payment_declined. Sin pedido, pago, correo ni stock consumido.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idempotencyKey\": \"cd414d7f-b001-4f54-bfa7-01966b8921f7\",\n  \"lines\": [\n    {\n      \"variantId\": \"satin-story-1\",\n      \"quantity\": 1\n    }\n  ],\n  \"expectedTotalCents\": 185000,\n  \"payment\": {\n    \"mode\": \"demo\",\n    \"method\": \"card\",\n    \"acknowledged\": true,\n    \"outcome\": \"declined\",\n    \"fulfillment\": {\n      \"method\": \"pickup\",\n      \"recipientName\": \"Cliente ficticio Maison\",\n      \"boutiqueId\": \"madrid-milla-oro\"\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "P05 · Pedidos tras rechazo",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/orders",
        "header": [
          {
            "key": "X-Maison-Request",
            "value": "1"
          }
        ],
        "description": "200. Lista vacía."
      }
    },
    {
      "name": "P06 · Correos tras rechazo",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/messages",
