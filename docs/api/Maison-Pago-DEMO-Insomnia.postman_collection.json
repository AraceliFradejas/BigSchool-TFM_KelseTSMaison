          {
            "key": "X-Maison-Request",
            "value": "1"
          }
        ],
        "description": "200. Lista vacía."
      }
    },
    {
      "name": "P07 · Stock tras rechazo",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/products/satin-story",
        "header": [
          {
            "key": "X-Maison-Request",
            "value": "1"
          }
        ],
        "description": "200. Stock6 intacto."
      }
    },
    {
      "name": "P08 · Total manipulado",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/checkout/demo",
        "header": [
          {
            "key": "X-Maison-Request",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "409 price_changed. Sin efectos en base.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idempotencyKey\": \"cd414d7f-b002-4f54-bfa7-01966b8921f7\",\n  \"lines\": [\n    {\n      \"variantId\": \"satin-story-1\",\n      \"quantity\": 1\n    }\n  ],\n  \"expectedTotalCents\": 1,\n  \"payment\": {\n    \"mode\": \"demo\",\n    \"method\": \"card\",\n    \"acknowledged\": true,\n    \"outcome\": \"approved\",\n    \"fulfillment\": {\n      \"method\": \"pickup\",\n      \"recipientName\": \"Cliente ficticio Maison\",\n      \"boutiqueId\": \"madrid-milla-oro\"\n    }\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
