{
  "name": "kelsets-maison",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w frontend",
    "start": "npm start -w backend",
    "test": "npm test -w backend && npm test -w packages/api-client",
    "seed": "npm run seed -w backend",
    "team:grant": "node --env-file-if-exists=backend/.env backend/scripts/grant-team.js"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
